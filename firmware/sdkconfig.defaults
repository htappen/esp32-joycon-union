# Joy-Con Bridge — pinned build configuration (NFR-10).
# Target: original ESP32 (ESP32-D0WD / WROOM-32), 4 MB flash, no PSRAM.
# Generate sdkconfig with: idf.py set-target esp32

#
# --- Flash / partitions -------------------------------------------------------
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

#
# --- Bluetooth: BTstack host, dual mode (BR/EDR + BLE) -----------------------
# Bluepad32 supplies BTstack as the host stack; the ESP32 controller runs in
# dual mode so it can hold 2 Classic HID links + 1 LE peripheral link (§7).
#
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n

# Host stack: not Bluedroid, not NimBLE — BTstack (provided by the bluepad32
# managed component). Disable the IDF host so nothing else claims the VHCI.
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y

# ACL connections: 2 Classic (the Joy-Cons). +1 headroom only if M4 heap allows.
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
# LE: 1 link (the downstream host).
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1

# Classic BT features we need for HID host; drop the rest.
CONFIG_BTDM_CTRL_PCM_ROLE_EDGE_CONFIG=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_PCM=n

# Pin the BT controller to core 0; app/merge run on core 1 (plan §3).
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y

# Modem sleep off in Play Mode — we want deterministic BT timing (NFR-1).
CONFIG_BTDM_CTRL_MODEM_SLEEP=n

#
# --- Wi-Fi + coexistence (Config Mode only, NFR-5) --------------------------
#
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Wi-Fi is started only when entering Config Mode and stopped on exit; in Play
# Mode esp_wifi_stop() is called so the radio budget is entirely BT's.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Keep Wi-Fi code in flash; Wi-Fi is only used in Config Mode and BTstack
# needs the limited IRAM for the always-on Classic + BLE controller.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

#
# --- HTTP server (Config Mode) ---------------------------------------------
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y

#
# --- No PSRAM: keep DRAM for BTstack (NFR-6) ------------------------------
#
CONFIG_ESP32_SPIRAM_SUPPORT=n
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

# Trim features we never use.
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_EXT_ADV=n

#
# --- Watchdogs (NFR-3) ----------------------------------------------------
#
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y

#
# --- Logging: quiet in release to save flash + CPU -----------------------
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

#
# --- NVS ----------------------------------------------------------------
#
CONFIG_NVS_ENCRYPTION=n
# Bluepad32 platform is supplied by joycon_host.c.
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_PLATFORM_UNIJOYSTICLE=n
