//
// xbox_hid.gatt — GATT database for the emulated Xbox-style BLE HID gamepad.
// Compiled to xbox_hid.h by BTstack's compile_gatt.py at build time
// (see CMakeLists.txt).
//
// HID-over-GATT (HOGP): GAP + GATT + Device Information + Battery + HID.
//

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "Xbox Wireless Controller"
CHARACTERISTIC, GAP_APPEARANCE, READ, 0x03C4

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,
CHARACTERISTIC, GATT_SERVICE_CHANGED, READ, INDICATE, DYNAMIC

PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_DEVICE_INFORMATION
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_MANUFACTURER_NAME_STRING, READ, "Microsoft"
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_MODEL_NUMBER_STRING,        READ, "1914"
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_FIRMWARE_REVISION_STRING,   READ, "5.17"
// PnP ID: source=USB(0x02), VID=0x045E, PID=0x0B13, version=0x0903  (all LE)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PNP_ID, READ, 02 5E 04 13 0B 03 09

PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_BATTERY_SERVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_BATTERY_LEVEL, READ, NOTIFY, DYNAMIC

PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_HUMAN_INTERFACE_DEVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_INFORMATION,   READ, 0x11, 0x01, 0x00, 0x02
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT_MAP,        READ,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_CONTROL_POINT, WRITE_WITHOUT_RESPONSE, DYNAMIC
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PROTOCOL_MODE,     READ, WRITE_WITHOUT_RESPONSE, DYNAMIC

// Input report (report ID 1)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, READ, NOTIFY, DYNAMIC
REPORT_REFERENCE, READ, 01, 01
